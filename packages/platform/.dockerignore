# Operator credentials and mutable evidence are never build inputs.
.env
.env.*
**/.env
**/.env.*
packages/platform/config/secrets.yaml
packages/platform/config/*.pem
packages/platform/config/*.key
**/*.pem
**/*.key

# Runtime data, generated artifacts, and repository metadata are not needed by
# the minimal image. Dockerfile COPY instructions whitelist the runtime source.
.git
.tmp
coverage
node_modules
**/node_modules
dist
.expo
*.log
