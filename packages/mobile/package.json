{
  "name": "@holocron/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client --ios",
    "dev:android": "expo start --dev-client --android",
    "dev:ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:ios": "expo run:ios",
    "build:ios:device": "expo run:ios --device",
    "build:android": "expo run:android",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "start:storybook": "STORYBOOK_ENABLED=true EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --clear",
    "start:storybook:ios": "STORYBOOK_ENABLED=true EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --ios --clear",
    "start:storybook:android": "STORYBOOK_ENABLED=true EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --android --clear",
    "eas:ios": "eas build --platform ios --profile production --auto-submit",
    "eas:android": "eas build --platform android --profile production"
  },
