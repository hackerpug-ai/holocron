---
# AC-3 / TC-3 + S31-FE-02 AC-6 — Chat thread loads messages via Zero query
# Prerequisite: seeded conversation with >=2 messages + healthy zero-cache.
# Connection pattern mirrors FE-05 / S31 session-loads (LAN Metro + Open dialog).

- launchApp:
    clearState: true

- openLink: ${MAESTRO_DEV_CLIENT_OPEN_URL}

- extendedWaitUntil:
    visible: \"Open\"
    timeout: 8000
    optional: true
- tapOn:
    text: \"Open\"
    optional: true

- extendedWaitUntil:
    visible: \"Enter URL manually\"
    timeout: 20000
    optional: true

- runFlow:
    when:
      visible: \"Enter URL manually\"
    commands:
      - tapOn:
          point: \"50%,28%\"
      - waitForAnimationToEnd

- runFlow:
    when:
      visible: \"http://192.168.1.160:8081\"
    commands:
      - tapOn: \"http://192.168.1.160:8081\"

- runFlow:
    when:
      visible: \"http://127.0.0.1:8081\"
    commands:
      - tapOn: \"http://127.0.0.1:8081\"

- extendedWaitUntil:
    visible: \"Continue\"
    timeout: 30000
    optional: true
- tapOn:
    text: \"Continue\"
    optional: true

- runFlow:
    when:
      visible: \"Go home\"
    commands:
      - tapOn:
          id: \"xmark\"
          optional: true
- runFlow:
    when:
      visible: \"Runtime version\"
    commands:
      - tapOn:
          id: \"xmark\"
          optional: true
- swipe:
