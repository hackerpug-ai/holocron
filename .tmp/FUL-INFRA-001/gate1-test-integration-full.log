    end: \"92%,75%\"
    duration: 500
    optional: true

- extendedWaitUntil:
    visible:
      text: \".*Type a message.*|.*New Chat.*|.*Holocron.*\"
    timeout: 120000
    optional: true

# Deep-link into the seeded conversation
- openLink: ${MAESTRO_CHAT_URL}

- extendedWaitUntil:
    visible: \"Open\"
    timeout: 6000
    optional: true
- tapOn:
    text: \"Open\"
    optional: true

# Prefer durable seed copy over ScreenLayout testIDs (XCTest often misses View testIDs)
- extendedWaitUntil:
    visible:
      text: \".*Hello from E2E Conversation Alpha.*|.*E2E Conversation Alpha.*\"
    timeout: 90000

- assertVisible:
    text: \".*Hello from E2E Conversation Alpha.*|.*E2E Conversation Alpha.*\"

# S31-FE-02 AC-6 happy path — healthy Zero must not surface terminal/degraded error chrome.
- assertNotVisible:
    id: \"chat-degraded-banner\"

- assertNotVisible:
    text: \"Live data sync unavailable\"
    optional: true

- takeScreenshot: S31-FE-02-AC-6-thread-loads
