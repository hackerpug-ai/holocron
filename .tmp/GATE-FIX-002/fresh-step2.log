# literal_cmd: TS=$(date +%s); G="Sprint-23 WIP1 concurrent test.echo subject $TS"; for i in 1 2 3 4 5 6; do curl -sS -o /tmp/gate-s23-wip-$i.json -w "R${i}_HTTP=%{http_code}\n" --max-time 30 -X POST http://127.0.0.1:4111/api/missions -H 'Authorization: Bearer rn-gate-s23' -H 'Content-Type: application/json' -d "{\"templateKey\":\"test.echo\",\"goal\":\"$G\",\"idempotencyKey\":\"wip-burst-$TS-$i\",\"args\":{\"goal\":\"$G\"}}" & done; wait; echo; OKN=0; WIPN=0; for i in 1 2 3 4 5 6; do B=$(tr -d '\n' </tmp/gate-s23-wip-$i.json); echo "R${i}=$B"; echo "$B" | grep -q '"ok": *true' && OKN=$((OKN+1)); echo "$B" | grep -q 'WIP_ONE_EXCEEDED' && WIPN=$((WIPN+1)); done; echo "OK_COUNT=$OKN WIP_COUNT=$WIPN"; if [ "$OKN" -ge 1 ] && [ "$WIPN" -ge 1 ]; then P1='STEP2_PROOF=ok'; P2='wip_body'; printf '%s+%s\n' "$P1" "$P2"; else N1='NO_WIP'; N2='_IN_BURST'; printf '%s%s\n' "$N1" "$N2"; exit 1; fi
