#!/usr/bin/env bash
# Minimal holo shim for S-REWRITE-02 AC-6 (S-REWRITE-05 will ship the real command).
set -euo pipefail
cmd="${1:-}"
shift || true
if [[ "$cmd" == "verify:no-convex-client" ]]; then
  roots=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --roots)
        roots="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done
  IFS=',' read -ra parts <<< "$roots"
  hits=0
  zero_hits=0
  for root in "${parts[@]}"; do
    root="$(echo "$root" | xargs)"
    [[ -z "$root" ]] && continue
    if [[ -e "$root" ]]; then
      c=$(rg -n "from ['\"]convex/react['\"]" "$root" 2>/dev/null | wc -l | tr -d ' ' || true)
      z=$(rg -n "@rocicorp/zero|app/zero" "$root" 2>/dev/null | wc -l | tr -d ' ' || true)
      c=${c:-0}
      z=${z:-0}
      # rg exit 1 (no match) must not abort under set -e
      hits=$((hits + c))
      zero_hits=$((zero_hits + z))
    fi
  done
  echo "holo verify:no-convex-client"
  echo "roots=$roots"
  echo "convex_react_import_hits=$hits"
  echo "zero_import_hits=$zero_hits"
  if [[ "$hits" -eq 0 ]]; then
    echo "STATUS: PASS"
    exit 0
  fi
  echo "STATUS: FAIL"
  exit 1
fi
echo "holo shim: unknown command: $cmd" >&2
exit 127
