# Root-context policy for packages/platform/Dockerfile. The release build uses
# `docker build -f packages/platform/Dockerfile .`, so this file—not the
# service-local .dockerignore—is the effective context boundary.
#
# Deny by default. The Dockerfile only needs these whitelisted runtime inputs.
**
!packages/
!packages/platform/
!packages/platform/fleet/
!packages/platform/fleet/manifest.json
!packages/platform/Dockerfile
!packages/platform/package.json
!packages/platform/bun.lock
!packages/platform/src/
!packages/platform/src/**
!.spec/
!.spec/prds/
!.spec/prds/mk6-migration/
!.spec/prds/mk6-migration/10-technical-requirements/
!.spec/prds/mk6-migration/10-technical-requirements/14-mcp-compatibility-manifest.yaml

# Explicit deny: never ship operator credentials even if a parent whitelist re-includes them.
# Must appear AFTER all `!…` whitelist rules so these patterns win the last-match rule.
packages/platform/config/secrets.yaml
**/.env
**/.env.*
**/*.pem
**/*.key
