# Platform Backend (MK-VI / T-PLAT-017)
# Local Mastra/Hono platform URL (not Convex)
# Format: http://127.0.0.1:4111 or your deployed platform base URL
EXPO_PUBLIC_PLATFORM_URL="http://127.0.0.1:4111"
# Self-hosted Zero cache URL for the Sprint 20 RN sync surface.
EXPO_PUBLIC_ZERO_CACHE_URL="http://127.0.0.1:4848"
EXPO_PUBLIC_ZERO_USER_ID="e2e-reference-user"
EXPO_PUBLIC_RN_API_KEY="set-on-the-real-device-build"
EXPO_PUBLIC_REFERENCE_CONVERSATION_ID="00000000-0000-0000-0000-000000000020"
EXPO_PUBLIC_REFERENCE_FLOW=false

# AI Provider API Keys
# Supported providers: OpenAI, Z.ai (GLM), Cohere
# Get your API key from your provider's dashboard
EXPO_PUBLIC_LLM_API_KEY="your-api-key-here"

# Additional provider keys (optional - for multi-provider setups)
ZAI_API_KEY="your-zhipu-api-key"
COHERE_API_KEY="your-cohere-api-key"

# DeepSeek — budgeted escape-hatch provider for the local inference fleet.
# Used by runBudgetedEscape / `holo infer:call --escape` when an operator opts in
# to a cloud fallback (default-deny; never used on the local-only default path).
# Get a key from https://platform.deepseek.com
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Langfuse — self-hosted local-first (S31-07 / UC-PLAT-04)
# Brought up by `holo stack:up` from services/platform/deploy/compose/langfuse.compose.yaml
# NEVER point at a vendor cloud host — standing local-first constraint.
LANGFUSE_BASE_URL="http://127.0.0.1:3100"
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."


# Structured Logging
# Client (React Native)
EXPO_PUBLIC_LOGGING_ENABLED=true
EXPO_PUBLIC_LOG_LEVEL=info

ELEVENLABS_API_KEY="YOUR_KEY"

# YouTube Data API v3 - For transcript fetching
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="AIzaSyD..."

# YouTube Service Account - For caption track downloads (RECOMMENDED)
# Service accounts don't require OAuth2 user interaction
# Setup: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download service account JSON key and set as Convex environment variable
# Command: npx convex env set GOOGLE_APPLICATION_CREDENTIALS_JSON '{"type":"service_account",...}'
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# YouTube OAuth2 - Alternative to service account (requires user interaction)
# Setup: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Redirect URI: http://localhost:3000/oauth/callback
YOUTUBE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
YOUTUBE_OAUTH_CLIENT_SECRET="your-client-secret"
YOUTUBE_OAUTH_REFRESH_TOKEN="your-refresh-token"

# Jina Reader API - Fallback for YouTube transcripts
# Get your API key from: https://jina.ai/reader
JINA_API_KEY="jina_..."

# Expo Owner - For EAS builds and Expo projects
# Your Expo account username or organization
EXPO_OWNER="your-username-or-org"

# Apple App Store Connect (ASC) Credentials - For iOS app submission
# Get these from your Apple Developer account: https://appstoreconnect.apple.com
EAS_ASC_APP_ID="your-app-id"
EAS_ASC_KEY_PATH="./keys/AuthKey_XXXXXXXXXX.p8"
EAS_ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
EAS_ASC_KEY_ID="XXXXXXXXXX"

# Danger Zone: clearAll mutations
# Set to "true" ONLY in local dev/testing environments to enable bulk-delete mutations.
# Leave unset (or set to anything other than "true") in production to block all clearAll calls.
# Set via Convex dashboard: npx convex env set ALLOW_CLEAR_ALL true
# ALLOW_CLEAR_ALL=true

# R2 object-read-only restore credentials (secrets — never commit real values)
# R2_RESTORE_ACCESS_KEY_ID=
# R2_RESTORE_SECRET_ACCESS_KEY=
# R2_RESTORE_SESSION_TOKEN=

# GATE-FIX-S28R3-QA14: known-existing scope probe keys (paths, not secrets).
# Bound in scripts/lib/r2-scope-probes.json (control-plane listed; not created).
# Out-of-prefix List/Head/Get must return AccessDenied (never 404).
R2_SCOPE_PROBE_IN_KEY=pgbackrest/archive/main/18-1/0000000100000005/0000000100000005000000E3-13f27e2e010416e3c641c1355c653bee6ec7a24b.gz
R2_SCOPE_PROBE_OUT_KEY=recovery-baselines/by-backup/20260728-182755F/e1525b1f368a45062149243b9ddfcdfe5dc54fdf23b25136c9ef0cf1037e6360/recovery-baseline.json
