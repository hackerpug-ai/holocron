{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowArbitraryExtensions": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./packages/mobile/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "packages/mobile/nativewind-env.d.ts", "vitest-env.d.ts"],
  "exclude": [
    "supabase/**/*",
    "packages/mcp/**/*",
    "holocron-mcp.backup/**/*",
    "holocron-general-mcp.old/**/*",
    "scripts/**/*",
    "tests/**/*",
    "src/**/__tests__/**/*",
    "packages/platform/**/*",
    "**/*.stories.tsx",
    "packages/mobile/.rnstorybook/**/*",
    "convex/creators/**/*",
    "convex/subscriptions/links.ts"
  ]
}
