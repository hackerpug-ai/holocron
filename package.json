{
  "name": "holocron",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "holo": "./bin/holo"
  },
  "scripts": {
    "start": "pnpm --filter @holocron/mobile start",
    "dev": "pnpm --filter @holocron/mobile dev",
    "dev:android": "pnpm --filter @holocron/mobile dev:android",
    "dev:ios": "pnpm --filter @holocron/mobile dev:ios",
    "client:dev": "pnpm --filter @holocron/mobile dev:ios",
    "web": "pnpm --filter @holocron/mobile web",
    "build:ios": "pnpm --filter @holocron/mobile build:ios",
    "build:ios:device": "pnpm --filter @holocron/mobile build:ios:device",
    "build:android": "pnpm --filter @holocron/mobile build:android",
    "build:ios:standalone": "bash scripts/prebuild-ios-release.sh",
    "build:android:standalone": "bash scripts/prebuild-android-release.sh",
    "clean:ios": "rm -rf packages/mobile/ios/build && rm -rf ~/Library/Developer/Xcode/DerivedData/holocron-*",
    "prebuild": "pnpm --filter @holocron/mobile prebuild",
    "prebuild:clean": "pnpm --filter @holocron/mobile prebuild:clean",
    "lint": "biome check .",
    "server:dev": "bun packages/platform/src/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test:lanes": "npx tsx scripts/check-test-lanes.ts",
    "test:watch": "vitest",
    "deploy": "git push origin main && gh release create v$(node -p \"require('./package.json').version\") --generate-notes --title v$(node -p \"require('./package.json').version\")",
    "deploy:ios": "pnpm --filter @holocron/mobile eas:ios",
    "deploy:android": "pnpm --filter @holocron/mobile eas:android",
    "verify:no-convex-env": "bun packages/platform/src/cli/holo.ts verify-no-convex-env",
    "verify:no-convex-client": "bun packages/platform/src/cli/holo.ts verify:no-convex-client",
    "verify:decommission-inventory": "bun packages/platform/src/cli/holo.ts verify:decommission-inventory",
    "seed:e2e": "bun packages/platform/src/cli/holo.ts seed:e2e --reset",
    "start:storybook": "pnpm --filter @holocron/mobile start:storybook",
    "start:storybook:ios": "pnpm --filter @holocron/mobile start:storybook:ios",
    "start:storybook:android": "pnpm --filter @holocron/mobile start:storybook:android",
    "prepare": "lefthook install",
    "test:seed-e2e": "vitest run packages/platform/src/cli/__tests__/seed-e2e.test.ts packages/platform/src/cli/__tests__/zero-cache-boot.test.ts packages/platform/src/cli/commands/__tests__/verify-no-convex-client.test.ts",
    "prd:consistency": "bun packages/platform/src/cli/holo.ts prd:consistency"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/openai-compatible": "3.0.10",
    "@mastra/acp": "0.4.0",
    "@mastra/core": "1.50.1",
    "@mastra/langfuse": "1.4.9",
    "@mastra/mcp": "1.13.1",
    "@mastra/observability": "1.17.1",
    "@mastra/otel-exporter": "1.3.9",
    "@mastra/pg": "1.15.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@rocicorp/zero": "1.8.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "ai": "^6.0.116",
    "date-fns": "^4.1.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "^0.45.2",
    "elevenlabs": "^1.59.0",
    "eventsource": "^3.0.7",
    "exa-js": "^2.7.0",
    "hono": "4.12.32",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "pg-boss": "10.4.2",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "uuid": "14.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@supabase/supabase-js": "^2.98.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "@typescript/native-preview": "7.0.0-dev.20260417.1",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^29.0.1",
    "lefthook": "^2.1.6",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18",
    "vitest-native": "^0.3.0"
  },
  "private": true
}
