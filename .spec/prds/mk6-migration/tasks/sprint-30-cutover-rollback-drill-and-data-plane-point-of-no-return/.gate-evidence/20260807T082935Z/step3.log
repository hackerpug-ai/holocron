import json, sys
from pathlib import Path
boot_path = Path('.tmp/D07-02/verify-fallback-boot.json')
# CLI may print JSON on stdout that was teed; also accept last JSON object
raw = boot_path.read_text() if boot_path.exists() else ''
# Prefer last complete JSON object in the file
obj = None
for line in raw.splitlines():
    line=line.strip()
    if line.startswith('{'):
        try:
            obj = json.loads(line)
        except Exception:
            pass
if obj is None and raw.strip().startswith('{'):
    try:
        obj = json.loads(raw)
    except Exception:
        obj = {}
if not isinstance(obj, dict):
    obj = {}
print(json.dumps({"ok": obj.get("ok"), "error": obj.get("error"), "short_sha": obj.get("short_sha") or obj.get("commit"), "boot": True}, indent=2))
if obj.get('ok') is not True:
    code = (obj.get('error') or {}).get('code') if isinstance(obj.get('error'), dict) else None
    if code == 'BOOT_UNVERIFIED' or obj.get('ok') is False:
        print('BOOT_UNVERIFIED_OR_FAIL', file=sys.stderr)
        sys.exit(2)
    print('STEP3_BOOT_NOT_OK', file=sys.stderr)
    sys.exit(2)
print('STEP3_PASS')
