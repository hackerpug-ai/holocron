            "must_not_observe": [
              "any step fails",
              "file_objects rows: 0 after upload (nothing promoted)",
              "file_objects rows > 1 after re-attach (dedup broken)",
              "orphan rows > 0 after voice cancel",
              "0 Maestro artifacts (empty)"
