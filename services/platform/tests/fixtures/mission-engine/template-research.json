      "outputSchema": { "schemaRef": "mission.research.output", "schemaVersion": 1 }
    }
  ],
  "toolGrants": [],
  "modelRoleBindings": {
    "plan_probe": "divergent",
    "assay": "divergent",
    "challenge": "convergent"
