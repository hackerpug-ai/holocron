      "inputSchema": { "schemaRef": "mission.goal", "schemaVersion": 1 },
      "outputSchema": { "schemaRef": "mission.probe.result", "schemaVersion": 1 }
    },
    {
      "id": "assay",
      "stageKind": "research.assay@1",
      "executorRef": "builtin.research-assay@1",
