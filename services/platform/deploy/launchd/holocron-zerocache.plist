<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  holocron-zerocache — HONESTLY DISABLED (not fake-healthy)

  Sprint 04 provisioned Postgres with publication zero_pub (wal_level=logical,
  reactive UI subset only). zero-cache binary / Zero sync client wiring is NOT
  done in Sprint 06 — docs/postgres-provisioning.md: "No Zero sync client /
  zero-cache wiring (later sprint)".

  Sprint 20 (CAP-SYNC-01 e2e) owns enabling this unit against zero_pub:
    - Real zero-cache binary path in ProgramArguments
    - Connection string to holocron DB + zero_pub logical replication slot
    - Disabled=false, KeepAlive=true, RunAtLoad=true
    - Logs must show consumption of zero_pub (never stub health)

  Until then: Disabled=true. launchctl list must NOT show a healthy PID for
  holocron-zerocache. Stack supervisor reports disabled, not healthy.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>holocron-zerocache</string>
	<key>Disabled</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<!-- Placeholder until Sprint 20 wires real zero-cache against zero_pub -->
		<string>/usr/bin/true</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@HOLO_ROOT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>HOLO_ROOT</key>
		<string>@HOLO_ROOT@</string>
		<!-- Intended when enabled (Sprint 20): zero_pub consumer -->
		<key>ZERO_UPSTREAM_DB</key>
		<string>@DATABASE_URL@</string>
		<key>ZERO_PUBLICATION</key>
		<string>zero_pub</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/holocron/zerocache.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/holocron/zerocache.err.log</string>
</dict>
</plist>
