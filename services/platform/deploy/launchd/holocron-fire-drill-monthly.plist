<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  holocron-fire-drill-monthly — CAP-BAK-01 / D05-05 monthly fire drill
  Runs: bun holo.ts mission run fire-drill-monthly ...
  Cadence: monthly (StartCalendarInterval Day=1 Hour=4). NEVER more frequent.
  Placeholders: @HOME@ @HOLO_ROOT@ @BUN_BIN@ @BUN_DIR@ @DATABASE_URL@
  Scratch defaults under @HOLO_ROOT@/.tmp/fire-drill-monthly/ (path isolation —
  legal on the real mini; live PGDATA / HOLO_BLOB_ROOT are refused by the CLI).
  Disabled key: omitted (unit eligible after bootstrap). Do NOT replace ProgramArguments
  with /usr/bin/true. To pause: launchctl bootout gui/$(id -u)/holocron-fire-drill-monthly
  Operator may also supply HOLO_FIRE_DRILL_TARGET_TIMESTAMP / R2 restore env for this host.
  Install: see .spec/prds/mk6-migration/runbooks/fire-drill-monthly.md §C
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>holocron-fire-drill-monthly</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BUN_BIN@</string>
		<string>@HOLO_ROOT@/services/platform/src/cli/holo.ts</string>
		<string>mission</string>
		<string>run</string>
		<string>fire-drill-monthly</string>
		<string>--goal</string>
		<string>CAP-BAK-01 monthly fire drill</string>
		<string>--idempotency-key</string>
		<string>fire-drill-monthly-scheduled</string>
		<string>--fresh</string>
		<string>--json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@HOLO_ROOT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>PATH</key>
		<string>@BUN_DIR@:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOLO_ROOT</key>
		<string>@HOLO_ROOT@</string>
		<key>DATABASE_URL</key>
		<string>@DATABASE_URL@</string>
		<key>HOLO_FIRE_DRILL_SCRATCH</key>
		<string>@HOLO_ROOT@/.tmp/fire-drill-monthly/scratch-pgdata</string>
		<key>HOLO_FIRE_DRILL_BLOB_DIR</key>
		<string>@HOLO_ROOT@/.tmp/fire-drill-monthly/scratch-blobs</string>
		<key>HOLO_FIRE_DRILL_REPORT</key>
		<string>@HOLO_ROOT@/.tmp/fire-drill-monthly/parity-report.json</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<!-- Monthly: 1st of each month at 04:00 local — not StartInterval -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/holocron/fire-drill-monthly.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/holocron/fire-drill-monthly.err.log</string>
</dict>
</plist>
