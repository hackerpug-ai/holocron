# Names/placeholders only. Export real values from the operator secret source;
# do not put them in this file or pass them as Docker build arguments.
# Default example host is holocron; any validated hostname is accepted.
HOLO_DEPLOY_TARGET=holocron
HOLO_PLATFORM_IMAGE=registry.example/holocron-platform@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FLEET_URL=http://inference-fleet:4545/v1
POSTGRES_DB=holocron
POSTGRES_USER=holocron
HOLO_POSTGRES_VOLUME=holocron-postgres
HOLO_BLOB_VOLUME=holocron-blobs
# Per-container memory limits (GiB). Sum must be ≤ 50. Smaller hosts use lower values.
HOLO_POSTGRES_MEM_LIMIT=16g
HOLO_MASTRA_MEM_LIMIT=16g
HOLO_SCHEDULER_MEM_LIMIT=8g
HOLO_ZERO_CACHE_MEM_LIMIT=10g
